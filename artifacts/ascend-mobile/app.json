{
  "expo": {
    "name": "Ascend: AI Fitness",
    "slug": "ascend-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ascend-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#080D12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ascendfit.app",
      "buildNumber": "36",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ascendfit.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ascend to access your photos to log meals.",
          "cameraPermission": "Allow Ascend to use your camera to take meal photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F59E0B",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "ascend-ai-coach",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "cc67b3fb-5b5a-4ab1-867d-5713bb821e15"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/cc67b3fb-5b5a-4ab1-867d-5713bb821e15"
    }
  }
}