{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "YOUR_REPLIT_DOMAIN_HERE"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "YOUR_REPLIT_DOMAIN_HERE"
      }
    },
    "production": {
      "autoIncrement": false,
      "channel": "production",
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "YOUR_REPLIT_DOMAIN_HERE"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "mike@mikequaglia.com",
        "ascAppId": "6784409058",
        "appleTeamId": "4BZY3Y44XW"
      }
    }
  }
}
