{
  "expo": {
    "name": "Ascend: AI Fitness",
    "slug": "ascend-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ascend-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080D12"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ascendfit.app",
      "buildNumber": "2",
      "minimumOsVersion": "15.1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ascendfit.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ascend to access your photos to log meals.",
          "cameraPermission": "Allow Ascend to use your camera to take meal photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "9f7ecdc3-860f-4b3a-803b-a5398b4f5079"
      }
    },
    "owner": "joshua7777",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9f7ecdc3-860f-4b3a-803b-a5398b4f5079"
    }
  }
}
